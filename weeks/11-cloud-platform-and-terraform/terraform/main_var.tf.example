# Part 4 reference: Terraform does not load files ending in .example.
# Complete variables.tf and terraform.tfvars before using this configuration.
# To use it, replace the contents of main.tf with this file's contents.
# Do not keep two active .tf files declaring these same resources.

terraform {
  required_version = ">= 1.11.4, < 2.0.0"

  required_providers {
    google = {
      source  = "hashicorp/google"
      version = "6.44.0"
    }
  }
}

# Authentication still uses GOOGLE_APPLICATION_CREDENTIALS from Part 2.
provider "google" {
  project = var.project_id
}

resource "google_storage_bucket" "raw_taxi" {
  name                        = var.bucket_name
  location                    = var.location
  storage_class               = "STANDARD"
  uniform_bucket_level_access = true
  public_access_prevention    = "enforced"
  force_destroy               = false
}

resource "google_bigquery_dataset" "taxi_analytics" {
  dataset_id = var.dataset_id
  location   = var.location
}
